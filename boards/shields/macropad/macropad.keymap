#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>


#define default_layer 0
#define fn_layer 1

&encoder0 {
    status = "okay";
};

&sensors {
    triggers-per-rotation = <20>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &tog 1  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_PREVIOUS
                &kp C_MUTE  &kp C_FF  &kp C_RW  &kp H
                &kp I  &kp J  &kp K  &kp L
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

        };
        
        fn_layer {
            bindings = <
                &tog 1  &kp F15  &kp F14  &kp F13
                &kp F19  &kp F18  &kp F17  &kp F16
                &kp F23  &kp F22  &kp F21  &kp F20    
            >;      
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;   
        };

    };
    
};
